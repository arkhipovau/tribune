{{!-- s-header: site header (superorganism). Params: home (bool), current ("about"|"teams") --}}
<header class="s-header">
  <nav class="a-pill s-header__nav" aria-label="Main">
    <a class="a-pill__item" href="about.html"{{#if (eq current "about")}} aria-current="page"{{/if}}>Manifesto</a>
    <a class="a-pill__item" href="teams.html"{{#if (eq current "teams")}} aria-current="page"{{/if}}>Teams</a>
    <a class="a-pill__item" href="{{#unless home}}index.html{{/unless}}#journal">Journal</a>
  </nav>
  <a class="s-header__logo" href="{{#if home}}#top{{else}}index.html{{/if}}" aria-label="Tribune — home">
    <img src="assets/svg/logo-header.svg" width="113" height="23" alt="tribune">
  </a>
  <div class="a-pill s-header__cta">
    <a class="a-pill__item" href="{{#unless home}}index.html{{/unless}}#participate">Participate</a>
    <a class="a-button a-button--white a-button--sm" href="{{#unless home}}index.html{{/unless}}#participate">Partner with us</a>
  </div>
</header>
